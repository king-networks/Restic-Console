[Unit]
Description=Restic Console (local web UI for restic backup jobs)
Documentation=https://github.com/king-networks/Restic-Console
After=network-online.target

[Service]
Type=simple
User=root
Environment=HOME=/root
ExecStart=@PYTHON@ -I @PREFIX@/server.py
Restart=on-failure
RestartSec=3
# Listens on 127.0.0.1 only. Root is needed to read what it backs up, for repository passwords,
# and to manage the job timers.
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
